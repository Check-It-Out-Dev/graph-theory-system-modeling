+    /**
+     * Close every ticket that has stayed RESOLVED for longer than the given number of days.
+     * Called by {@link StaleTicketCloseCronJob}.
+     *
+     * @param olderThanDays how long a ticket must have been resolved
+     * @return the number of tickets closed
+     */
+    @Transactional
+    public int closeStaleResolvedTickets(int olderThanDays) {
+        LocalDateTime cutoff = LocalDateTime.now().minusDays(olderThanDays);
+        List<SupportTicket> stale = ticketRepository.findByStatusAndResolvedTimeBefore(TicketStatus.RESOLVED, cutoff);
+        for (SupportTicket ticket : stale) {
+            ticket.setStatus(TicketStatus.CLOSED);
+            ticket.setLastUpdateTime(LocalDateTime.now());
+            ticketRepository.save(ticket);
+        }
+        log.info("Closed {} support tickets resolved before {}", stale.size(), cutoff);
+        return stale.size();
+    }
