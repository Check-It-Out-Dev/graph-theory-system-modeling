+    /**
+     * Reorder the active FAQs of a category in one step: the FAQ at position i gets display order i + 1.
+     *
+     * @param categoryId the category
+     * @param faqIds     every active FAQ id of the category, each once, in the new order
+     * @throws BusinessRuleTranslatableException (error.business.faq_reorder_mismatch) when the list does not match
+     */
+    @Transactional
+    public void reorderCategory(Long categoryId, List<Long> faqIds) {
+        FaqCategory category = faqCategoryRepository.findById(categoryId)
+                .orElseThrow(() -> new ResourceNotFoundException("error.business.item_not_found", "FAQ Category"));
+        List<Faq> active = faqRepository.findByCategoryAndActiveTrueOrderByDisplayOrderAsc(category);
+
+        Map<Long, Faq> byId = new HashMap<>();
+        for (Faq faq : active) {
+            byId.put(faq.getId(), faq);
+        }
+        if (faqIds == null || faqIds.size() != active.size() || !new HashSet<>(faqIds).equals(byId.keySet())) {
+            throw new BusinessRuleTranslatableException("error.business.faq_reorder_mismatch");
+        }
+
+        List<Faq> reordered = new ArrayList<>(faqIds.size());
+        for (int i = 0; i < faqIds.size(); i++) {
+            Faq faq = byId.get(faqIds.get(i));
+            faq.setDisplayOrder(i + 1);
+            reordered.add(faq);
+        }
+        faqRepository.saveAll(reordered);
+        log.info("GDPR: Service=reorderCategory, Operation=UPDATE, CategoryID={}, Count={}, Purpose=content_management",
+                categoryId, reordered.size());
+    }
