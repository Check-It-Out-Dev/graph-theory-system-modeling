+            assertThat(result.getCountsByStatus()).containsEntry(TicketStatus.WAITING_FOR_CUSTOMER, 0L);
+            assertThat(result.getCountsByStatus()).containsEntry(TicketStatus.RESOLVED, 1L);
+            assertThat(result.getCountsByStatus()).containsEntry(TicketStatus.CLOSED, 0L);
