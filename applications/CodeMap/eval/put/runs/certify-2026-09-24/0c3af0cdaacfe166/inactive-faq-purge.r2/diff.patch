+    /**
+     * Purge inactive FAQs that have not been updated for longer than the given number of days.
+     * Called by the weekly purge cron job.
+     *
+     * @param days The number of days of inactivity after which an FAQ is purged
+     * @return The number of FAQs deleted
+     */
+    @Transactional
+    public int purgeInactiveOlderThan(int days) {
+        LocalDateTime cutoff = LocalDateTime.now().minusDays(days);
+        List<Faq> inactiveFaqs = faqRepository.findByActiveFalseAndLastUpdateTimeBefore(cutoff);
+        if (inactiveFaqs.isEmpty()) {
+            return 0;
+        }
+        faqRepository.deleteAll(inactiveFaqs);
+        return inactiveFaqs.size();
+    }
 }
