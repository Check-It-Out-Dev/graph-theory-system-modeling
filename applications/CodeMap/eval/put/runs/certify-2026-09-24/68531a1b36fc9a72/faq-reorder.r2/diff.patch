+    /**
+     * Reorder the active FAQs of a category.
+     * The given list must hold exactly the ids of the category's active FAQs, each once, in any order;
+     * the FAQ at position i is assigned display order i + 1.
+     *
+     * @param categoryId The category ID
+     * @param faqIds     The FAQ ids in the desired display order
+     */
+    @Transactional
+    public void reorderCategory(Long categoryId, List<Long> faqIds) {
+        FaqCategory category = faqCategoryRepository.findById(categoryId)
+                .orElseThrow(() -> new ResourceNotFoundException("error.business.item_not_found", "FAQ Category"));
+
+        List<Faq> faqs = faqRepository.findByCategoryAndActiveTrueOrderByDisplayOrderAsc(category);
+
+        Set<Long> expectedIds = faqs.stream().map(Faq::getId).collect(Collectors.toSet());
+        Set<Long> givenIds = faqIds == null ? Set.of() : new HashSet<>(faqIds);
+
+        if (faqIds == null || faqIds.size() != faqs.size() || !givenIds.equals(expectedIds)) {
+            throw new BusinessRuleTranslatableException("error.business.faq_reorder_mismatch");
+        }
+
+        Map<Long, Faq> faqsById = faqs.stream().collect(Collectors.toMap(Faq::getId, faq -> faq));
+
+        for (int i = 0; i < faqIds.size(); i++) {
+            Faq faq = faqsById.get(faqIds.get(i));
+            faq.setDisplayOrder(i + 1);
+            save(faq);
+        }
+    }
