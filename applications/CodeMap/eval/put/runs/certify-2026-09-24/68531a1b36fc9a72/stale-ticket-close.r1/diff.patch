+    /**
+     * Close every RESOLVED ticket whose resolvedTime is older than the given
+     * number of days. Called by the nightly stale-ticket-close cron job.
+     *
+     * @param olderThanDays How many days a ticket may sit RESOLVED before it is auto-closed
+     * @return The number of tickets closed
+     */
+    @Transactional
+    public int closeStaleResolvedTickets(int olderThanDays) {
+        LocalDateTime cutoff = LocalDateTime.now().minusDays(olderThanDays);
+        List<SupportTicket> staleTickets = ticketRepository.findByStatusAndResolvedTimeBefore(TicketStatus.RESOLVED, cutoff);
+
+        for (SupportTicket ticket : staleTickets) {
+            ticket.setStatus(TicketStatus.CLOSED);
+            ticket.setLastUpdateTime(LocalDateTime.now());
+            ticketRepository.save(ticket);
+        }
+
+        if (!staleTickets.isEmpty()) {
+            log.info("Closed {} stale resolved tickets (resolved more than {} days ago)", staleTickets.size(), olderThanDays);
+        }
+
+        return staleTickets.size();
+    }
