+
+        service.reorderCategory(CATEGORY_ID, List.of(30L, 10L, 20L));
+
+        ArgumentCaptor<Faq> captor = ArgumentCaptor.forClass(Faq.class);
+        verify(faqRepository, times(3)).save(captor.capture());
