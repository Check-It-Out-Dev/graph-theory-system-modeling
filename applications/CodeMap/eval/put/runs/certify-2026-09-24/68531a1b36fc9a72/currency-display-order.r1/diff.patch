+                    repositoryResolver, applicationContext);
+        }
+
+        @Test
+        @DisplayName("toDto should carry the entity's displayOrder into the DTO")
+        void toDtoShouldMapDisplayOrder() throws Exception {
+            // Given
+            Currency entity = new Currency(9L, "Polish Zloty", "PLN", "zł", "PL", 1);
+            CurrencyService service = newService(new ModelMapper());
+
+            // When
+            CurrencyDtoOut dto = service.toDto(entity);
