+    /**
+     * Get ticket creation counts per status for a period.
+     * Admin endpoint.
+     *
+     * @param from Start of the period (inclusive)
+     * @param to   End of the period (inclusive)
+     * @return Ticket counts by status, plus the total
+     */
+    @Transactional(readOnly = true)
+    public TicketStatsDtoOut getTicketStats(LocalDate from, LocalDate to) {
+        String adminUid = permissionUtils.getUserId();
+
+        if (!permissionUtils.isAdmin()) {
+            throw new InsufficientPermissionsException(
+                    "error.auth.insufficient_permissions",
+                    adminUid,
+                    "getTicketStats",
+                    "SupportTicket");
+        }
+
+        if (from.isAfter(to)) {
+            throw new ValidationTranslatableException("error.validation.invalid_date_range");
+        }
+
+        // GDPR: Log admin ticket stats access
+        log.info("GDPR: Operation=getTicketStats, FirebaseUID={}, From={}, To={}, Purpose=support_management, DataAccessed=ticket.stats",
+                adminUid, from, to);
+
+        LocalDateTime start = from.atStartOfDay();
+        LocalDateTime end = to.plusDays(1).atStartOfDay();
+
+        Map<TicketStatus, Long> countsByStatus = new LinkedHashMap<>();
+        long total = 0;
+        for (TicketStatus status : TicketStatus.values()) {
+            long count = ticketRepository.countByStatusAndCreatedTimeBetween(status, start, end);
+            countsByStatus.put(status, count);
+            total += count;
+        }
+
+        return new TicketStatsDtoOut(countsByStatus, total);
+    }
