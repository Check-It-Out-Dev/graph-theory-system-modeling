+@ExtendWith(MockitoExtension.class)
+@MockitoSettings(strictness = Strictness.LENIENT)
+@DisplayName("FaqService Unit Tests")
+class FaqServiceUnitTest {
+
+    @Mock
+    private SpecificationBuilder<Faq> specificationBuilder;
