+    /**
+     * Reorder the active FAQs of a category in one request.
+     * The FAQ at position i in the list gets display order i + 1.
+     *
+     * @param categoryId The category ID
+     * @param faqIds     The ids of the category's active FAQs, each once, in the desired order
+     * @throws BusinessRuleTranslatableException if faqIds does not hold exactly the ids of the
+     *                                            category's active FAQs, each once
+     */
+    @Transactional
+    public void reorderCategory(Long categoryId, List<Long> faqIds) {
+        FaqCategory category = faqCategoryRepository.findById(categoryId)
+                .orElseThrow(() -> new ResourceNotFoundException("error.business.item_not_found", "FAQ Category"));
+
+        List<Faq> activeFaqs = faqRepository.findByCategoryAndActiveTrue(category);
+
+        Set<Long> activeFaqIds = activeFaqs.stream().map(Faq::getId).collect(Collectors.toSet());
+        Set<Long> submittedFaqIds = faqIds == null ? Set.of() : new HashSet<>(faqIds);
+
+        if (faqIds == null || faqIds.size() != activeFaqs.size() || !activeFaqIds.equals(submittedFaqIds)) {
+            throw new BusinessRuleTranslatableException("error.business.faq_reorder_mismatch");
+        }
+
+        Map<Long, Faq> faqsById = activeFaqs.stream().collect(Collectors.toMap(Faq::getId, faq -> faq));
+        for (int i = 0; i < faqIds.size(); i++) {
+            Faq faq = faqsById.get(faqIds.get(i));
+            faq.setDisplayOrder(i + 1);
+            save(faq);
+        }
+    }
+
