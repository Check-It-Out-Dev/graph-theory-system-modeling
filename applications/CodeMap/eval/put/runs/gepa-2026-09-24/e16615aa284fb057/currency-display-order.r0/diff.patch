diff --git a/src/main/resources/db/changelog/2026/09/24-09-2026-add-display-order-to-currency.sql b/src/main/resources/db/changelog/2026/09/24-09-2026-add-display-order-to-currency.sql
new file mode 100644
index 00000000000..8500396c5df
--- /dev/null
+++ b/src/main/resources/db/changelog/2026/09/24-09-2026-add-display-order-to-currency.sql
@@ -0,0 +1,10 @@
+--liquibase formatted sql
+--changeset system:add-display-order-to-currency
+
+ALTER TABLE currency ADD COLUMN IF NOT EXISTS display_order INT NOT NULL DEFAULT 0;
+
+UPDATE currency SET display_order = 1 WHERE iso_code = 'PLN';
+UPDATE currency SET display_order = 2 WHERE iso_code = 'EUR';
+UPDATE currency SET display_order = 3 WHERE iso_code = 'USD';
+
+-- rollback ALTER TABLE currency DROP COLUMN display_order;
