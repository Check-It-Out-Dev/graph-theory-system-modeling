+    /**
+     * Reorder the active FAQs of a category in one request.
+     * The list must hold exactly the ids of the category's active FAQs, each once, in any order.
+     * The FAQ at position i gets display order i + 1.
+     *
+     * @param categoryId The category ID
+     * @param faqIds     The FAQ ids in their new display order
+     */
+    @Transactional
+    public void reorderCategory(Long categoryId, List<Long> faqIds) {
+        List<Faq> categoryFaqs = getFaqsByCategory(categoryId);
+
+        Set<Long> expectedIds = categoryFaqs.stream().map(Faq::getId).collect(Collectors.toSet());
+        Set<Long> submittedIds = faqIds == null ? new HashSet<>() : new HashSet<>(faqIds);
+
+        if (faqIds == null || faqIds.size() != categoryFaqs.size() || !submittedIds.equals(expectedIds)) {
+            throw new BusinessRuleTranslatableException("error.business.faq_reorder_mismatch");
+        }
+
+        Map<Long, Faq> faqsById = categoryFaqs.stream().collect(Collectors.toMap(Faq::getId, faq -> faq));
+        for (int i = 0; i < faqIds.size(); i++) {
+            Faq faq = faqsById.get(faqIds.get(i));
+            faq.setDisplayOrder(i + 1);
+            save(faq);
+        }
+    }
