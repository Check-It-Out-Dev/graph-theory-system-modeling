+    }
+
+    private Faq createFaq(Long id, FaqCategory category, int displayOrder) {
+        Faq faq = new Faq();
+        faq.setId(id);
+        faq.setCategory(category);
+        faq.setQuestion("Question " + id);
+        faq.setAnswer("Answer " + id);
+        faq.setDisplayOrder(displayOrder);
+        faq.setActive(true);
+        return faq;
+    }
+
+    @Nested
