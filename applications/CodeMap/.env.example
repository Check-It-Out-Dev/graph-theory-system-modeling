# CodeMap API tier — copy to .env and fill in. The .env file is gitignored; the key
# is read by app/api_tier.py, never logged, and never returned by any endpoint.
ANTHROPIC_API_KEY=
# optional: default escalation model alias (default|budget|deep) or a verbatim model id
CODEMAP_API_MODEL=default
# optional BIG LOCAL tier (app/big_tier.py): a large instruct gguf in bin/models/
# is auto-detected (Qwen3-Next-80B preferred); pin a path or port to override.
# CODEMAP_BIG_GGUF=C:/path/to/model.gguf
# CODEMAP_BIG_PORT=7352
