 },
 "description": "A coding agent's conventions prompt, measured per rule, iterated by GEPA, certified on held-out tasks (applications/CodeMap/eval/put). One point per campaign; the committed artifacts are the record. Public.",
 "editable": false,
 "graphTooltip": 1,
 "links": [
  {
   "targetBlank": true,
   "title": "CodeMap Remote — the design",
   "type": "link",
   "url": "https://github.com/Check-It-Out-Dev/graph-theory-system-modeling/blob/main/applications/CodeMap/docs/07-ai-quality-governance.md"
  }
 ],
 "panels": [
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": [],
   "title": "Campaigns: score and noise",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "Mean over tasks of the mean over replicates (eval/put/METRICS.md section 3).",
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "id": 2,
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max by (campaign) (put_score)",
     "legendFormat": "{{campaign}}",
     "refId": "A"
    }
   ],
   "title": "Score by campaign",
   "type": "bargauge"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "max(judge test-retest MAD, agent replicate half-width): every gain is read against it.",
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "id": 3,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max(put_delta)",
     "legendFormat": "delta",
     "refId": "A"
    }
   ],
   "title": "Noise floor δ (baseline)",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "id": 4,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max by (campaign) (put_holdout_gain)",
     "legendFormat": "{{campaign}}",
     "refId": "A"
    }
   ],
   "title": "Hold-out gain (certification)",
   "type": "stat"
  },
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 9
   },
   "id": 5,
   "panels": [],
   "title": "Per rule: how often the agent follows each written rule",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "A run passes a rule only at value 1; rates over the runs the rule applies to.",
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "id": 6,
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max by (rule) (put_rule_rate)",
     "legendFormat": "{{rule}}",
     "refId": "A"
    }
   ],
   "title": "Pass rate by rule (latest campaign point)",
   "type": "bargauge"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "A rule is obligatory at a lower bound of 0.90; with no failure that needs 35 runs.",
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 12,
    "y": 10
   },
   "id": 7,
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max by (rule) (put_rule_wilson_lo)",
     "legendFormat": "{{rule}}",
     "refId": "A"
    }
   ],
   "title": "Lower Wilson bound by rule",
   "type": "bargauge"
  },
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 20
   },
   "id": 8,
   "panels": [],
   "title": "Tokens: the campaign's own sessions (subscription), by role",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 2,
      "pointSize": 7,
      "showPoints": "always",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 21
   },
   "id": 9,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (role) (claude_code_token_usage_tokens_total{campaign!=\"\"})",
     "legendFormat": "{{role}}",
     "refId": "A"
    }
   ],
   "title": "Tokens per role (coder, judge, reflector)",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 21
   },
   "id": 10,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max by (campaign) (put_budget_exhausted)",
     "legendFormat": "{{campaign}}",
     "refId": "A"
    }
   ],
   "title": "Sessions ended by the output-token budget",
   "type": "stat"
  }
 ],
