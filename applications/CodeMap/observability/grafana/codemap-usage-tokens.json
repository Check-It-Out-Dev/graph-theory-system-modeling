 "description": "Tokens on the server side (the navigator) and on the users' side (Claude Code personas, judge, reflector). Public.",
 "editable": false,
 "graphTooltip": 1,
 "links": [
  {
   "targetBlank": true,
   "title": "CodeMap Remote — the design",
   "type": "link",
   "url": "https://github.com/Check-It-Out-Dev/graph-theory-system-modeling/blob/main/applications/CodeMap/docs/07-ai-quality-governance.md"
  }
 ],
 "panels": [
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": [],
   "title": "Server: the navigator's tokens",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "id": 2,
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (type) (max_over_time(codemap_tokens_total{tier=~\"nav-.*\"}[$__range]))",
     "legendFormat": "{{type}}",
     "refId": "A"
    }
   ],
   "title": "Tokens by type (navigator)",
   "type": "bargauge"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "cached / (cached + created + fresh). Follow-ups resume the Claude session, so the second turn is mostly cache.",
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "id": 3,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "codemap_quality_cache_read_ratio",
     "legendFormat": "cache",
     "refId": "A"
    }
   ],
   "title": "Cache read ratio (last night)",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "id": 4,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": true
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (user) (max_over_time(codemap_requests_total{event_type=\"ask\"}[$__range]))",
     "legendFormat": "{{user}}",
     "refId": "A"
    }
   ],
   "title": "Requests by user",
   "type": "stat"
